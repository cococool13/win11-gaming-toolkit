Windows Registry Editor Version 5.00

; Revert: re-enable Game Bar / Game DVR
; Pair with: disable-game-bar-dvr.reg
; CURSOR-AUDIT #20

[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000001
"AudioCaptureEnabled"=dword:00000001
"HistoricalCaptureEnabled"=-
"CursorCaptureEnabled"=-
"MicrophoneCaptureEnabled"=-
"VKToggleGameBar"=-
"VKMToggleGameBar"=-

[HKEY_CURRENT_USER\Software\Microsoft\GameBar]
"UseNexusForGameBarEnabled"=dword:00000001
"GamepadNexusChordEnabled"=dword:00000001
; AutoGameModeEnabled stays at 1 — it's a performance setting and was
; already on by default; disable-game-bar-dvr.reg only asserts the state.
